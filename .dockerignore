# Version control
.git/
.gitattributes
.gitignore

# Host-side infrastructure and observability configuration
infrastructure/

# IDE and editor state
.vs/
.vscode/
.idea/
**/*.suo
**/*.user
**/*.userosscache
**/*.sln.docstates

# .NET build, publish, and package artifacts
**/bin/
**/obj/
**/publish/
**/artifacts/
**/packages/
**/*.nupkg
**/*.snupkg
**/*.binlog
**/Properties/launchSettings.json

# Front-end dependencies and generated output
**/node_modules/
**/dist/
**/.vite/
**/.cache/
**/wwwroot/
**/.eslintcache
**/.npm/
**/.yarn/
**/.pnpm-store/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Tests, coverage, and reports
**/TestResults/
**/coverage/
**/coverage-report/
**/coverage*.json
**/coverage*.xml
**/coverage*.info
**/*.coverage
**/*.coveragexml

# Local configuration, secrets, and credentials
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/config.dev.json
**/secrets*.json
**/*.pfx
**/*.p12
**/*.pem
**/*.key

# Logs and temporary files
**/logs/
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.swp
**/*~

# Operating-system metadata
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
