[Unit]
Description=Back up Lambda Pulse Lens PostgreSQL to Amazon S3
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/opt/lambda-pulse-lens/compose.ec2.yaml
ConditionPathExists=/opt/lambda-pulse-lens/.env.ec2

[Service]
Type=oneshot
User=root
Group=root
Environment=APP_DIR=/opt/lambda-pulse-lens
Environment=BACKUP_BUCKET=lambda-pulse-lens-backups-948529527750-eu-west-2
Environment=AWS_REGION=eu-west-2
ExecStart=/usr/local/sbin/lambda-pulse-lens-postgres-backup
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true

