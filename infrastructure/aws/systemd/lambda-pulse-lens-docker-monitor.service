[Unit]
Description=Publish Lambda Pulse Lens Docker health metrics to CloudWatch
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=AWS_REGION=eu-west-2
Environment=METRIC_NAMESPACE=LambdaPulseLens
ExecStart=/usr/local/sbin/lambda-pulse-lens-docker-monitor
TimeoutStartSec=60
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

